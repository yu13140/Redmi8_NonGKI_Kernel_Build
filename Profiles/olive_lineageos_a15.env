CONFIG_ENV=Profiles/olive_lineageos_a15.env

DEVICE_NAME=Redmi_8
DEVICE_CODENAME=olive

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS:LD=ld.lld AS=llvm-as AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump STRIP=llvm-strip

KERNEL_SOURCE=https://github.com/blazey66/android_kernel_xiaomi_sdm439-4.19.git
KERNEL_BRANCH=ksu-next-susfs
CLANG_SOURCE=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/main/clang-r536225.tar.gz
CLANG_BRANCH=

GCC_GNU=false
GCC_64_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9.git
GCC_64_BRANCH=android-14.0.0_r0.140
GCC_32_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9.git
GCC_32_BRANCH=android-14.0.0_r0.140

DEFCONFIG_SOURCE=
DEFCONFIG_NAME=gki_defconfig
DEFCONFIG_ORIGIN_DEFCONFIG=

KERNELSU_SOURCE=https://raw.githubusercontent.com/ShirkNeko/SukiSU-Ultra/refs/heads/susfs-main/kernel/setup.sh
KERNELSU_BRANCH=susfs-main
KERNELSU_NAME=KernelSU

SUSFS_ENABLE=false
SUSFS_FIXED=true
SUSFS_UPDATE=false

AK3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
AK3_BRANCH=master

BOOT_SOURCE=https://raw.githubusercontent.com/yu13140/Redmi8_Kernel_Patches/refs/heads/main/LineageOS_4.19.325/boot.img

LXC_ENABLE=false

HAVE_NO_DTBO=true
HAVE_NO_DTBO_TOOL=true

ROM_TEXT=LineageOS_Android15
